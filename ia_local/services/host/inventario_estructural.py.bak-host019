from __future__ import annotations

import re
import unicodedata
from pathlib import Path
from typing import Any

from .inspector_llamadas import construir_indice_simbolos
from .inspector_proyecto import (
    obtener_apps_instaladas,
    obtener_modelos_proyecto,
    obtener_templates,
    obtener_urls_proyecto,
)


# ============================================================
# IA-HOST018 - INVENTARIO ESTRUCTURAL GLOBAL
# ============================================================

RECURSOS = {
    "apps": ("app", "apps", "aplicacion", "aplicaciones"),
    "modelos": ("modelo", "modelos"),
    "urls": ("url", "urls", "ruta", "rutas"),
    "views": ("view", "views", "vista", "vistas"),
    "funciones": ("funcion", "funciones"),
    "templates": ("template", "templates", "plantilla", "plantillas"),
}

MARCADORES_ALCANCE_GLOBAL = (
    "proyecto",
    "django",
    "sistema",
    "codigo",
    "codigo fuente",
)

MARCADORES_CANTIDAD_GLOBAL = (
    "todos",
    "todas",
    "completo",
    "completa",
    "completos",
    "completas",
)


# ============================================================
# UTILIDADES
# ============================================================

def _texto(valor: Any) -> str:
    return str(valor or "").strip()


def _normalizar(valor: Any) -> str:
    texto = unicodedata.normalize("NFKD", _texto(valor))
    texto = "".join(
        caracter
        for caracter in texto
        if not unicodedata.combining(caracter)
    )
    texto = texto.lower()
    texto = re.sub(r"\s+", " ", texto)
    return texto.strip()


def _contiene_palabra(texto: str, palabra: str) -> bool:
    patron = r"(?<![\w])" + re.escape(palabra) + r"(?![\w])"
    return bool(re.search(patron, texto))


def _esta_dentro(ruta: str, directorio: str) -> bool:
    try:
        Path(ruta).resolve().relative_to(Path(directorio).resolve())
        return True
    except (OSError, RuntimeError, ValueError):
        return False


def _apps_host() -> list[dict[str, Any]]:
    """
    Devuelve únicamente las apps del proyecto anfitrión.

    Excluye:
    - django.contrib
    - ia_local

    La clasificación ya la realiza inspector_proyecto.py.
    """
    return [
        item
        for item in obtener_apps_instaladas()
        if item.get("tipo") == "proyecto"
    ]


def _labels_apps_host() -> set[str]:
    return {
        _texto(item.get("label"))
        for item in _apps_host()
        if _texto(item.get("label"))
    }


def _paths_apps_host() -> list[str]:
    return [
        _texto(item.get("path"))
        for item in _apps_host()
        if _texto(item.get("path"))
    ]


def _path_ia_local() -> str:
    for item in obtener_apps_instaladas():
        if item.get("tipo") == "ia_local":
            return _texto(item.get("path"))
    return ""


# ============================================================
# DETECCION DE CONSULTA GLOBAL
# ============================================================

def detectar_consulta_inventario(
    pregunta: str,
) -> dict[str, Any] | None:
    """
    Detecta preguntas que solicitan un inventario estructural
    global del proyecto.

    Ejemplos válidos:
        ¿Qué modelos Django existen en este proyecto?
        ¿Qué URLs están registradas en este proyecto?
        Listame todas las funciones de este proyecto.
        ¿Qué templates existen?

    No captura consultas estructurales específicas como:
        ¿Qué funciones usan Document?
        ¿Dónde está definida Document?
        ¿Qué hace la URL ia/consultar/?

    No utiliza LLM.
    """

    texto = _normalizar(pregunta)

    if not texto:
        return None

    recurso = None

    for nombre_recurso, aliases in RECURSOS.items():
        if any(
            _contiene_palabra(texto, alias)
            for alias in aliases
        ):
            recurso = nombre_recurso
            break

    if not recurso:
        return None

    tiene_alcance_global = any(
        marcador in texto
        for marcador in MARCADORES_ALCANCE_GLOBAL
    )

    tiene_cantidad_global = any(
        _contiene_palabra(texto, marcador)
        for marcador in MARCADORES_CANTIDAD_GLOBAL
    )

    tiene_forma_existencial = bool(
        re.search(
            r"\b(que|cuales)\b.*\b(existen|hay|registrad[oa]s?)\b",
            texto,
        )
    )

    # HOST018 sólo resuelve inventarios verdaderamente globales.
    # Las consultas sobre una app, archivo, modelo o función concreta
    # quedan para los resolutores estructurales específicos.
    if not (
        tiene_alcance_global
        or tiene_cantidad_global
        or tiene_forma_existencial
    ):
        return None

    return {
        "tipo": "estructura",
        "subtipo": "inventario",
        "accion": "listar",
        "recurso": recurso,
        "alcance": "proyecto",
        "validado": True,
        "origen": "determinista",
        "confianza": "alta",
    }


# ============================================================
# INVENTARIOS
# ============================================================

def _inventario_apps() -> list[dict[str, Any]]:
    resultado = []

    for item in _apps_host():
        resultado.append(
            {
                "label": item.get("label"),
                "name": item.get("name"),
                "verbose_name": item.get("verbose_name"),
                "path": item.get("path"),
                "modelos": item.get("modelos"),
                "tipo": item.get("tipo"),
            }
        )

    resultado.sort(
        key=lambda item: _texto(item.get("label")).lower()
    )

    return resultado


def _inventario_modelos() -> list[dict[str, Any]]:
    labels_host = _labels_apps_host()
    resultado = []

    for item in obtener_modelos_proyecto():
        if _texto(item.get("app_label")) not in labels_host:
            continue

        resultado.append(
            {
                "label": item.get("label"),
                "app_label": item.get("app_label"),
                "modelo": item.get("modelo"),
                "tabla": item.get("tabla"),
                "verbose_name": item.get("verbose_name"),
                "verbose_name_plural": item.get("verbose_name_plural"),
                "campos": item.get("campos"),
            }
        )

    resultado.sort(
        key=lambda item: _texto(item.get("label")).lower()
    )

    return resultado


def _view_pertenece_host(view: str) -> bool:
    view = _texto(view)

    if not view:
        return False

    for app in _apps_host():
        nombre = _texto(app.get("name"))
        label = _texto(app.get("label"))

        if nombre and (
            view == nombre
            or view.startswith(f"{nombre}.")
        ):
            return True

        if label and (
            view == label
            or view.startswith(f"{label}.")
        ):
            return True

    return False


def _inventario_urls() -> list[dict[str, Any]]:
    resultado = []

    for item in obtener_urls_proyecto():
        if item.get("error"):
            continue

        view = _texto(item.get("view"))

        if not _view_pertenece_host(view):
            continue

        resultado.append(
            {
                "ruta": item.get("ruta"),
                "name": item.get("name"),
                "namespace": item.get("namespace"),
                "view": view,
            }
        )

    resultado.sort(
        key=lambda item: (
            _texto(item.get("ruta")),
            _texto(item.get("view")),
        )
    )

    return resultado


def _inventario_views() -> list[dict[str, Any]]:
    agrupadas: dict[str, dict[str, Any]] = {}

    for item in _inventario_urls():
        view = _texto(item.get("view"))

        if not view:
            continue

        if view not in agrupadas:
            agrupadas[view] = {
                "view": view,
                "urls": [],
            }

        agrupadas[view]["urls"].append(
            {
                "ruta": item.get("ruta"),
                "name": item.get("name"),
                "namespace": item.get("namespace"),
            }
        )

    resultado = list(agrupadas.values())
    resultado.sort(
        key=lambda item: _texto(item.get("view")).lower()
    )

    return resultado


def _inventario_funciones() -> list[dict[str, Any]]:
    paths_host = _paths_apps_host()
    indice = construir_indice_simbolos()
    resultado = []

    for item in indice.get("simbolos", []):
        if item.get("tipo") not in {
            "funcion",
            "funcion_async",
        }:
            continue

        ruta = _texto(item.get("ruta"))

        if not any(
            _esta_dentro(ruta, app_path)
            for app_path in paths_host
        ):
            continue

        resultado.append(
            {
                "nombre": item.get("nombre"),
                "qualname": item.get("qualname"),
                "modulo": item.get("modulo"),
                "archivo": item.get("archivo"),
                "tipo": item.get("tipo"),
                "linea_inicio": item.get("linea_inicio"),
                "linea_fin": item.get("linea_fin"),
            }
        )

    resultado.sort(
        key=lambda item: _texto(item.get("qualname")).lower()
    )

    return resultado


def _inventario_templates() -> list[dict[str, Any]]:
    ia_local_path = _path_ia_local()
    resultado = []

    for item in obtener_templates():
        ruta = _texto(item.get("ruta"))

        if (
            ia_local_path
            and _esta_dentro(ruta, ia_local_path)
        ):
            continue

        resultado.append(
            {
                "archivo": item.get("archivo"),
                "ruta": ruta,
                "bytes": item.get("bytes"),
            }
        )

    resultado.sort(
        key=lambda item: _texto(item.get("archivo")).lower()
    )

    return resultado


# ============================================================
# RESPUESTAS DETERMINISTAS
# ============================================================

def _respuesta_apps(resultados: list[dict[str, Any]]) -> str:
    lineas = [
        (
            f"Se encontraron {len(resultados)} "
            "aplicaciones del proyecto anfitrión:"
        )
    ]

    for item in resultados:
        linea = f"- {item.get('label')}"
        verbose_name = _texto(item.get("verbose_name"))

        if verbose_name:
            linea += f" ({verbose_name})"

        lineas.append(linea)

    return "\n".join(lineas)


def _respuesta_modelos(resultados: list[dict[str, Any]]) -> str:
    lineas = [
        (
            f"Se encontraron {len(resultados)} "
            "modelos Django pertenecientes al proyecto anfitrión:"
        )
    ]

    for item in resultados:
        lineas.append(
            f"- {item.get('label')} [tabla: {item.get('tabla')}]"
        )

    return "\n".join(lineas)


def _respuesta_urls(resultados: list[dict[str, Any]]) -> str:
    lineas = [
        (
            f"Se encontraron {len(resultados)} "
            "URLs asociadas al código del proyecto anfitrión:"
        )
    ]

    for item in resultados:
        lineas.append(
            f"- {item.get('ruta')} → {item.get('view')}"
        )

    return "\n".join(lineas)


def _respuesta_views(resultados: list[dict[str, Any]]) -> str:
    lineas = [
        (
            f"Se encontraron {len(resultados)} "
            "views asociadas al proyecto anfitrión:"
        )
    ]

    for item in resultados:
        lineas.append(f"- {item.get('view')}")

    return "\n".join(lineas)


def _respuesta_funciones(resultados: list[dict[str, Any]]) -> str:
    lineas = [
        (
            f"Se encontraron {len(resultados)} "
            "funciones Python de nivel superior "
            "en las aplicaciones del proyecto anfitrión:"
        )
    ]

    for item in resultados:
        lineas.append(
            (
                f"- {item.get('qualname')} "
                f"[{item.get('archivo')}:{item.get('linea_inicio')}]"
            )
        )

    return "\n".join(lineas)


def _respuesta_templates(resultados: list[dict[str, Any]]) -> str:
    lineas = [
        (
            f"Se encontraron {len(resultados)} "
            "templates del proyecto anfitrión:"
        )
    ]

    for item in resultados:
        lineas.append(f"- {item.get('archivo')}")

    return "\n".join(lineas)


# ============================================================
# EJECUCION PUBLICA
# ============================================================

def ejecutar_consulta_inventario(
    pregunta: str,
    plan: dict[str, Any],
) -> dict[str, Any]:
    """
    Ejecuta una consulta de inventario estructural global.

    Los hechos provienen exclusivamente de los inspectores HOST.
    Qwen no participa en esta operación.
    """

    recurso = _texto(plan.get("recurso"))

    if recurso == "apps":
        resultados = _inventario_apps()
        respuesta = _respuesta_apps(resultados)

    elif recurso == "modelos":
        resultados = _inventario_modelos()
        respuesta = _respuesta_modelos(resultados)

    elif recurso == "urls":
        resultados = _inventario_urls()
        respuesta = _respuesta_urls(resultados)

    elif recurso == "views":
        resultados = _inventario_views()
        respuesta = _respuesta_views(resultados)

    elif recurso == "funciones":
        resultados = _inventario_funciones()
        respuesta = _respuesta_funciones(resultados)

    elif recurso == "templates":
        resultados = _inventario_templates()
        respuesta = _respuesta_templates(resultados)

    else:
        return {
            "ok": False,
            "pregunta": pregunta,
            "respondido_por": "host",
            "llm_invocado": False,
            "error": (
                "El recurso estructural solicitado "
                "no está soportado."
            ),
        }

    return {
        "ok": True,
        "pregunta": pregunta,
        "respondido_por": "host",
        "llm_invocado": False,
        "hay_evidencia": True,
        "tipo": "inventario_estructural",
        "recurso": recurso,
        "alcance": "proyecto",
        "total": len(resultados),
        "plan": plan,
        "resultados": resultados,
        "deteccion": {
            "inventario": recurso,
            "total": len(resultados),
        },
        "contexto": (
            "Inventario estructural obtenido directamente "
            "desde el proyecto Django anfitrión. "
            "No se utilizó LLM para determinar los hechos."
        ),
        "respuesta": respuesta,
    }
