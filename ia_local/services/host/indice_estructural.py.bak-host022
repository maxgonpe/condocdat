from __future__ import annotations

import ast
from collections import defaultdict, deque
from functools import lru_cache
from typing import Any

from django.apps import apps

from .inspector_llamadas import (
    construir_indice_simbolos,
)
from .inspector_modelos_codigo import (
    _buscar_nodo_simbolo,
    _catalogar_imports_modelos,
    _detectar_operacion_orm,
    _leer_archivo,
    _parsear,
    _resolver_get_model,
    construir_catalogo_modelos,
)
from .inspector_proyecto import (
    obtener_apps_instaladas,
)
from .inspector_urls import (
    construir_mapa_urls,
)


# ============================================================
# IA-HOST020 - ÍNDICE ESTRUCTURAL INVERSO
# ============================================================
#
# Objetivo:
#
#   evitar reconstruir un grafo completo por cada view cuando
#   se pregunta, por ejemplo:
#
#       ¿Qué views utilizan documents.Document?
#
# El índice:
#
#   - recorre el código del host una sola vez;
#   - parsea cada archivo Python del host una sola vez;
#   - detecta uso directo de modelos por símbolo;
#   - construye relaciones simples entre símbolos;
#   - genera índices inversos modelo -> símbolos/views;
#   - valida todo contra apps/modelos/símbolos reales.
#
# No contiene nombres específicos del proyecto anfitrión.
#
# HOST022 ampliará esta base con métricas, invalidación y
# diagnóstico formal de caché. Aquí sólo se mantiene un índice
# process-local mínimo porque HOST020 necesita evitar el coste
# observado de reconstruir decenas de grafos independientes.
# ============================================================


def _texto(
    valor: Any,
) -> str:
    return str(
        valor
        or ""
    ).strip()


def _normalizar(
    valor: Any,
) -> str:
    return (
        _texto(
            valor
        )
        .lower()
    )


# ============================================================
# APPS HOST
# ============================================================

def _apps_host() -> list[dict[str, Any]]:

    return [
        item
        for item
        in obtener_apps_instaladas()
        if item.get(
            "tipo"
        ) == "proyecto"
    ]


def _labels_apps_host() -> set[str]:

    return {
        _normalizar(
            item.get(
                "label"
            )
        )
        for item
        in _apps_host()
        if _texto(
            item.get(
                "label"
            )
        )
    }


def _nombres_apps_host() -> tuple[str, ...]:

    nombres = []

    for item in _apps_host():

        nombre = _texto(
            item.get(
                "name"
            )
        )

        if nombre:
            nombres.append(
                nombre
            )

    nombres.sort(
        key=len,
        reverse=True,
    )

    return tuple(
        nombres
    )


def _simbolo_es_host(
    simbolo: dict[str, Any],
    nombres_apps: tuple[str, ...],
) -> bool:

    modulo = _texto(
        simbolo.get(
            "modulo"
        )
    )

    if not modulo:
        return False

    return any(
        (
            modulo == nombre
            or modulo.startswith(
                f"{nombre}."
            )
        )
        for nombre
        in nombres_apps
    )


# ============================================================
# RESOLUCIÓN EXACTA
# ============================================================

def resolver_modelo_exacto(
    referencia: str,
    *,
    catalogo: dict[str, Any] | None = None,
) -> dict[str, Any] | None:
    """
    Resuelve un modelo contra el catálogo Django real.

    Acepta:
        documents.Document
        Document

    Para nombre corto exige que exista un único modelo host
    con ese nombre.
    """

    if catalogo is None:
        catalogo = (
            construir_catalogo_modelos()
        )

    objetivo = _normalizar(
        referencia
    )

    if not objetivo:
        return None

    labels_host = (
        _labels_apps_host()
    )

    # --------------------------------------------------------
    # LABEL COMPLETO EXACTO
    # --------------------------------------------------------

    exacto = (
        catalogo.get(
            "por_label",
            {},
        ).get(
            objetivo
        )
    )

    if exacto:

        if _normalizar(
            exacto.get(
                "app_label"
            )
        ) in labels_host:

            return exacto

        return None

    # --------------------------------------------------------
    # NOMBRE CORTO EXACTO
    # --------------------------------------------------------

    candidatos = [
        item
        for item
        in catalogo.get(
            "por_nombre",
            {},
        ).get(
            objetivo,
            [],
        )
        if _normalizar(
            item.get(
                "app_label"
            )
        ) in labels_host
    ]

    if len(
        candidatos
    ) != 1:
        return None

    return candidatos[0]


def resolver_simbolo_exacto(
    referencia: str,
    *,
    indice_simbolos: dict[str, Any] | None = None,
) -> dict[str, Any] | None:
    """
    Resuelve símbolos del host de forma exacta.

    Prioridad:
        1. qualname completo;
        2. nombre simple, sólo si es único en el host.
    """

    if indice_simbolos is None:
        indice_simbolos = (
            construir_indice_simbolos()
        )

    objetivo = _normalizar(
        referencia
    )

    if not objetivo:
        return None

    nombres_apps = (
        _nombres_apps_host()
    )

    # --------------------------------------------------------
    # QUALNAME EXACTO
    # --------------------------------------------------------

    for qualname, simbolo in (
        indice_simbolos.get(
            "por_qualname",
            {},
        ).items()
    ):

        if _normalizar(
            qualname
        ) != objetivo:
            continue

        if not _simbolo_es_host(
            simbolo,
            nombres_apps,
        ):
            return None

        return simbolo

    # --------------------------------------------------------
    # NOMBRE SIMPLE ÚNICO
    # --------------------------------------------------------

    candidatos = []

    for nombre, items in (
        indice_simbolos.get(
            "por_nombre",
            {},
        ).items()
    ):

        if _normalizar(
            nombre
        ) != objetivo:
            continue

        for simbolo in items:

            if _simbolo_es_host(
                simbolo,
                nombres_apps,
            ):
                candidatos.append(
                    simbolo
                )

    if len(
        candidatos
    ) != 1:
        return None

    return candidatos[0]


# ============================================================
# USO DE MODELOS POR ARCHIVO / SÍMBOLO
# ============================================================

def _analizar_modelos_archivo(
    simbolos: list[dict[str, Any]],
    *,
    catalogo: dict[str, Any],
    labels_host: set[str],
) -> tuple[
    dict[str, list[dict[str, Any]]],
    dict[str, list[dict[str, Any]]],
]:
    """
    Analiza todos los símbolos de un mismo archivo haciendo
    una sola lectura y un solo ast.parse() del archivo.
    """

    por_simbolo_modelos: dict[
        str,
        list[dict[str, Any]],
    ] = {}

    por_simbolo_operaciones: dict[
        str,
        list[dict[str, Any]],
    ] = {}

    if not simbolos:
        return (
            por_simbolo_modelos,
            por_simbolo_operaciones,
        )

    ruta = _texto(
        simbolos[0].get(
            "ruta"
        )
    )

    if not ruta:
        return (
            por_simbolo_modelos,
            por_simbolo_operaciones,
        )

    contenido = _leer_archivo(
        ruta
    )

    if not contenido:
        return (
            por_simbolo_modelos,
            por_simbolo_operaciones,
        )

    arbol = _parsear(
        contenido,
        ruta,
    )

    if arbol is None:
        return (
            por_simbolo_modelos,
            por_simbolo_operaciones,
        )

    modulo_actual = _texto(
        simbolos[0].get(
            "modulo"
        )
    )

    aliases_modelos = (
        _catalogar_imports_modelos(
            arbol,
            catalogo,
            modulo_actual=modulo_actual,
        )
    )

    for simbolo in simbolos:

        qualname = _texto(
            simbolo.get(
                "qualname"
            )
        )

        if not qualname:
            continue

        nodo = _buscar_nodo_simbolo(
            arbol,
            _texto(
                simbolo.get(
                    "nombre"
                )
            ),
            simbolo.get(
                "linea_inicio"
            ),
        )

        if nodo is None:
            por_simbolo_modelos[
                qualname
            ] = []

            por_simbolo_operaciones[
                qualname
            ] = []

            continue

        encontrados: dict[
            str,
            dict[str, Any],
        ] = {}

        operaciones = []

        for sub in ast.walk(
            nodo
        ):

            if not isinstance(
                sub,
                ast.Call,
            ):
                continue

            operacion = (
                _detectar_operacion_orm(
                    sub,
                    aliases_modelos,
                )
            )

            if operacion:

                modelo = (
                    operacion.get(
                        "modelo"
                    )
                    or {}
                )

                app_label = (
                    _normalizar(
                        modelo.get(
                            "app_label"
                        )
                    )
                )

                if app_label in labels_host:

                    label = _texto(
                        modelo.get(
                            "label"
                        )
                    )

                    if label:

                        encontrados[
                            label
                        ] = modelo

                        operaciones.append(
                            operacion
                        )

            modelo_dinamico = (
                _resolver_get_model(
                    sub,
                    catalogo,
                )
            )

            if modelo_dinamico:

                app_label = (
                    _normalizar(
                        modelo_dinamico.get(
                            "app_label"
                        )
                    )
                )

                if app_label in labels_host:

                    label = _texto(
                        modelo_dinamico.get(
                            "label"
                        )
                    )

                    if label:

                        encontrados[
                            label
                        ] = modelo_dinamico

        modelos = list(
            encontrados.values()
        )

        modelos.sort(
            key=lambda item: (
                _normalizar(
                    item.get(
                        "label"
                    )
                )
            )
        )

        operaciones.sort(
            key=lambda item: (
                item.get(
                    "linea"
                )
                or 0,
                _normalizar(
                    (
                        item.get(
                            "modelo"
                        )
                        or {}
                    ).get(
                        "label"
                    )
                ),
                _normalizar(
                    item.get(
                        "operacion"
                    )
                ),
            )
        )

        por_simbolo_modelos[
            qualname
        ] = modelos

        por_simbolo_operaciones[
            qualname
        ] = operaciones

    return (
        por_simbolo_modelos,
        por_simbolo_operaciones,
    )


# ============================================================
# RELACIONES ENTRE SÍMBOLOS
# ============================================================

def _resolver_llamada_conservadora(
    llamada: str,
    *,
    simbolo_origen: dict[str, Any],
    indice_simbolos: dict[str, Any],
    qualnames_host: set[str],
) -> str | None:
    """
    Resolución intencionalmente conservadora para construir
    el índice inverso rápido.

    Se aceptan:
        - qualname exacto;
        - función del mismo módulo;
        - nombre simple único dentro del host.

    Las llamadas con punto no se fuerzan por nombre simple,
    porque podrían ser métodos de objetos y generar aristas falsas.
    """

    llamada = _texto(
        llamada
    )

    if not llamada:
        return None

    # --------------------------------------------------------
    # QUALNAME EXACTO
    # --------------------------------------------------------

    if llamada in qualnames_host:
        return llamada

    nombre_simple = (
        llamada
        .split(".")[-1]
        .strip()
    )

    if not nombre_simple:
        return None

    # --------------------------------------------------------
    # MISMO MÓDULO
    # --------------------------------------------------------

    modulo = _texto(
        simbolo_origen.get(
            "modulo"
        )
    )

    if modulo:

        local = (
            f"{modulo}."
            f"{nombre_simple}"
        )

        if local in qualnames_host:
            return local

    # --------------------------------------------------------
    # LLAMADA SIMPLE ÚNICA
    # --------------------------------------------------------

    if "." in llamada:
        return None

    candidatos = [
        item
        for item
        in indice_simbolos.get(
            "por_nombre",
            {},
        ).get(
            nombre_simple,
            [],
        )
        if _texto(
            item.get(
                "qualname"
            )
        ) in qualnames_host
    ]

    if len(
        candidatos
    ) != 1:
        return None

    return _texto(
        candidatos[0].get(
            "qualname"
        )
    )


def _construir_aristas_codigo(
    simbolos_host: list[dict[str, Any]],
    indice_simbolos: dict[str, Any],
) -> tuple[
    dict[str, list[str]],
    dict[str, list[str]],
]:
    """
    Devuelve:
        llamadas_por_simbolo
        llamadores_por_simbolo
    """

    qualnames_host = {
        _texto(
            item.get(
                "qualname"
            )
        )
        for item
        in simbolos_host
        if _texto(
            item.get(
                "qualname"
            )
        )
    }

    llamadas_por_simbolo: dict[
        str,
        list[str],
    ] = {}

    llamadores_temporal: dict[
        str,
        set[str],
    ] = defaultdict(
        set
    )

    for simbolo in simbolos_host:

        origen = _texto(
            simbolo.get(
                "qualname"
            )
        )

        if not origen:
            continue

        destinos = []

        vistos = set()

        for llamada in simbolo.get(
            "llamadas",
            [],
        ):

            destino = (
                _resolver_llamada_conservadora(
                    _texto(
                        llamada.get(
                            "nombre"
                        )
                    ),
                    simbolo_origen=simbolo,
                    indice_simbolos=indice_simbolos,
                    qualnames_host=qualnames_host,
                )
            )

            if not destino:
                continue

            if destino in vistos:
                continue

            vistos.add(
                destino
            )

            destinos.append(
                destino
            )

            llamadores_temporal[
                destino
            ].add(
                origen
            )

        destinos.sort(
            key=str.lower
        )

        llamadas_por_simbolo[
            origen
        ] = destinos

    llamadores_por_simbolo = {
        destino:
            sorted(
                origenes,
                key=str.lower,
            )
        for destino, origenes
        in llamadores_temporal.items()
    }

    return (
        llamadas_por_simbolo,
        llamadores_por_simbolo,
    )


# ============================================================
# VIEWS REGISTRADAS
# ============================================================

def _construir_views_host() -> dict[str, dict[str, Any]]:

    resultado: dict[
        str,
        dict[str, Any],
    ] = {}

    for item in construir_mapa_urls():

        app = (
            item.get(
                "app"
            )
            or {}
        )

        if app.get(
            "tipo"
        ) != "proyecto":
            continue

        view = _texto(
            item.get(
                "view"
            )
        )

        if not view:
            continue

        perfil = resultado.setdefault(
            view,
            {
                "view":
                    view,

                "archivo":
                    item.get(
                        "archivo"
                    ),

                "app":
                    app,

                "urls":
                    [],
            },
        )

        perfil[
            "urls"
        ].append(
            {
                "ruta":
                    item.get(
                        "ruta"
                    ),

                "name":
                    item.get(
                        "name"
                    ),

                "namespace":
                    item.get(
                        "namespace"
                    ),

                "view":
                    view,
            }
        )

    for perfil in resultado.values():

        perfil[
            "urls"
        ].sort(
            key=lambda item: (
                _texto(
                    item.get(
                        "ruta"
                    )
                ),
                _texto(
                    item.get(
                        "name"
                    )
                ),
            )
        )

    return resultado


# ============================================================
# ÍNDICE PRINCIPAL
# ============================================================

@lru_cache(
    maxsize=1
)
def construir_indice_estructural() -> dict[str, Any]:
    """
    Construye el índice estructural HOST020.

    La caché es process-local y deliberadamente mínima.
    HOST022 añadirá política formal de invalidación y métricas.
    """

    indice_simbolos = (
        construir_indice_simbolos()
    )

    catalogo = (
        construir_catalogo_modelos()
    )

    labels_host = (
        _labels_apps_host()
    )

    nombres_apps = (
        _nombres_apps_host()
    )

    simbolos_host = [
        item
        for item
        in indice_simbolos.get(
            "simbolos",
            [],
        )
        if _simbolo_es_host(
            item,
            nombres_apps,
        )
    ]

    # --------------------------------------------------------
    # AGRUPAR POR ARCHIVO
    # --------------------------------------------------------

    por_archivo: dict[
        str,
        list[dict[str, Any]],
    ] = defaultdict(
        list
    )

    for simbolo in simbolos_host:

        ruta = _texto(
            simbolo.get(
                "ruta"
            )
        )

        if not ruta:
            continue

        por_archivo[
            ruta
        ].append(
            simbolo
        )

    por_simbolo_modelos: dict[
        str,
        list[dict[str, Any]],
    ] = {}

    por_simbolo_operaciones: dict[
        str,
        list[dict[str, Any]],
    ] = {}

    # --------------------------------------------------------
    # UNA LECTURA / PARSEO POR ARCHIVO
    # --------------------------------------------------------

    for simbolos in por_archivo.values():

        (
            modelos_archivo,
            operaciones_archivo,
        ) = _analizar_modelos_archivo(
            simbolos,
            catalogo=catalogo,
            labels_host=labels_host,
        )

        por_simbolo_modelos.update(
            modelos_archivo
        )

        por_simbolo_operaciones.update(
            operaciones_archivo
        )

    # --------------------------------------------------------
    # ÍNDICE INVERSO MODELO -> SÍMBOLOS
    # --------------------------------------------------------

    por_modelo_simbolos: dict[
        str,
        list[dict[str, Any]],
    ] = defaultdict(
        list
    )

    simbolos_por_qualname = {
        _texto(
            item.get(
                "qualname"
            )
        ):
            item
        for item
        in simbolos_host
        if _texto(
            item.get(
                "qualname"
            )
        )
    }

    for qualname, modelos in (
        por_simbolo_modelos.items()
    ):

        simbolo = (
            simbolos_por_qualname.get(
                qualname
            )
        )

        if not simbolo:
            continue

        for modelo in modelos:

            label = _normalizar(
                modelo.get(
                    "label"
                )
            )

            if not label:
                continue

            por_modelo_simbolos[
                label
            ].append(
                {
                    "qualname":
                        qualname,

                    "nombre":
                        simbolo.get(
                            "nombre"
                        ),

                    "modulo":
                        simbolo.get(
                            "modulo"
                        ),

                    "archivo":
                        simbolo.get(
                            "archivo"
                        ),

                    "linea_inicio":
                        simbolo.get(
                            "linea_inicio"
                        ),

                    "linea_fin":
                        simbolo.get(
                            "linea_fin"
                        ),

                    "tipo":
                        simbolo.get(
                            "tipo"
                        ),
                }
            )

    for items in por_modelo_simbolos.values():

        items.sort(
            key=lambda item: (
                _normalizar(
                    item.get(
                        "qualname"
                    )
                )
            )
        )

    # --------------------------------------------------------
    # GRAFO DE CÓDIGO GLOBAL LIGERO
    # --------------------------------------------------------

    (
        llamadas_por_simbolo,
        llamadores_por_simbolo,
    ) = _construir_aristas_codigo(
        simbolos_host,
        indice_simbolos,
    )

    # --------------------------------------------------------
    # VIEWS REGISTRADAS
    # --------------------------------------------------------

    views = (
        _construir_views_host()
    )

    return {
        "catalogo_modelos":
            catalogo,

        "indice_simbolos":
            indice_simbolos,

        "simbolos_host":
            simbolos_host,

        "simbolos_por_qualname":
            simbolos_por_qualname,

        "por_simbolo_modelos":
            por_simbolo_modelos,

        "por_simbolo_operaciones":
            por_simbolo_operaciones,

        "por_modelo_simbolos":
            dict(
                por_modelo_simbolos
            ),

        "llamadas_por_simbolo":
            llamadas_por_simbolo,

        "llamadores_por_simbolo":
            llamadores_por_simbolo,

        "views":
            views,
    }


# ============================================================
# CONSULTAS DEL ÍNDICE
# ============================================================

def obtener_funciones_que_usan_modelo(
    modelo: str,
) -> dict[str, Any]:

    indice = (
        construir_indice_estructural()
    )

    modelo_item = (
        resolver_modelo_exacto(
            modelo,
            catalogo=indice[
                "catalogo_modelos"
            ],
        )
    )

    if not modelo_item:

        return {
            "ok":
                False,

            "modelo":
                modelo,

            "error":
                "Modelo no resuelto de forma exacta.",
        }

    label = _texto(
        modelo_item.get(
            "label"
        )
    )

    resultados = list(
        indice[
            "por_modelo_simbolos"
        ].get(
            label.lower(),
            [],
        )
    )

    return {
        "ok":
            True,

        "modelo":
            modelo_item,

        "total":
            len(
                resultados
            ),

        "resultados":
            resultados,
    }


def obtener_llamadas_simbolo(
    simbolo: str,
) -> dict[str, Any]:

    indice = (
        construir_indice_estructural()
    )

    simbolo_item = (
        resolver_simbolo_exacto(
            simbolo,
            indice_simbolos=indice[
                "indice_simbolos"
            ],
        )
    )

    if not simbolo_item:

        return {
            "ok":
                False,

            "simbolo":
                simbolo,

            "error":
                "Símbolo no resuelto de forma exacta.",
        }

    qualname = _texto(
        simbolo_item.get(
            "qualname"
        )
    )

    destinos = list(
        indice[
            "llamadas_por_simbolo"
        ].get(
            qualname,
            [],
        )
    )

    return {
        "ok":
            True,

        "simbolo":
            simbolo_item,

        "total":
            len(
                destinos
            ),

        "resultados":
            destinos,
    }


def obtener_llamadores_simbolo(
    simbolo: str,
) -> dict[str, Any]:

    indice = (
        construir_indice_estructural()
    )

    simbolo_item = (
        resolver_simbolo_exacto(
            simbolo,
            indice_simbolos=indice[
                "indice_simbolos"
            ],
        )
    )

    if not simbolo_item:

        return {
            "ok":
                False,

            "simbolo":
                simbolo,

            "error":
                "Símbolo no resuelto de forma exacta.",
        }

    qualname = _texto(
        simbolo_item.get(
            "qualname"
        )
    )

    origenes = list(
        indice[
            "llamadores_por_simbolo"
        ].get(
            qualname,
            [],
        )
    )

    return {
        "ok":
            True,

        "simbolo":
            simbolo_item,

        "total":
            len(
                origenes
            ),

        "resultados":
            origenes,
    }


def obtener_modelos_alcanzados_por_simbolo(
    simbolo: str,
    *,
    profundidad: int = 2,
) -> dict[str, Any]:
    """
    Devuelve modelos usados directamente por el símbolo o por
    funciones internas alcanzables hasta la profundidad indicada.
    """

    indice = (
        construir_indice_estructural()
    )

    simbolo_item = (
        resolver_simbolo_exacto(
            simbolo,
            indice_simbolos=indice[
                "indice_simbolos"
            ],
        )
    )

    if not simbolo_item:

        return {
            "ok":
                False,

            "simbolo":
                simbolo,

            "error":
                "Símbolo no resuelto de forma exacta.",
        }

    raiz = _texto(
        simbolo_item.get(
            "qualname"
        )
    )

    cola = deque(
        [
            (
                raiz,
                0,
                [
                    raiz
                ],
            )
        ]
    )

    vistos = {
        raiz
    }

    modelos: dict[
        str,
        dict[str, Any],
    ] = {}

    evidencias: dict[
        str,
        list[dict[str, Any]],
    ] = defaultdict(
        list
    )

    while cola:

        (
            actual,
            nivel,
            camino,
        ) = cola.popleft()

        for modelo_item in indice[
            "por_simbolo_modelos"
        ].get(
            actual,
            [],
        ):

            label = _texto(
                modelo_item.get(
                    "label"
                )
            )

            if not label:
                continue

            modelos[
                label
            ] = modelo_item

            evidencias[
                label
            ].append(
                {
                    "simbolo":
                        actual,

                    "distancia":
                        nivel,

                    "camino":
                        camino,
                }
            )

        if nivel >= profundidad:
            continue

        for destino in indice[
            "llamadas_por_simbolo"
        ].get(
            actual,
            [],
        ):

            if destino in vistos:
                continue

            vistos.add(
                destino
            )

            cola.append(
                (
                    destino,
                    nivel + 1,
                    [
                        *camino,
                        destino,
                    ],
                )
            )

    resultado_modelos = list(
        modelos.values()
    )

    resultado_modelos.sort(
        key=lambda item: (
            _normalizar(
                item.get(
                    "label"
                )
            )
        )
    )

    return {
        "ok":
            True,

        "simbolo":
            simbolo_item,

        "profundidad":
            profundidad,

        "total":
            len(
                resultado_modelos
            ),

        "modelos":
            resultado_modelos,

        "evidencias":
            dict(
                evidencias
            ),
    }


def obtener_views_que_usan_modelo(
    modelo: str,
    *,
    profundidad: int = 2,
) -> dict[str, Any]:
    """
    Índice inverso:
        modelo <- símbolo <- callers <- view registrada

    No reconstruye un grafo completo por cada view.
    """

    indice = (
        construir_indice_estructural()
    )

    modelo_item = (
        resolver_modelo_exacto(
            modelo,
            catalogo=indice[
                "catalogo_modelos"
            ],
        )
    )

    if not modelo_item:

        return {
            "ok":
                False,

            "modelo":
                modelo,

            "error":
                "Modelo no resuelto de forma exacta.",
        }

    label = _texto(
        modelo_item.get(
            "label"
        )
    )

    simbolos_directos = [
        _texto(
            item.get(
                "qualname"
            )
        )
        for item
        in indice[
            "por_modelo_simbolos"
        ].get(
            label.lower(),
            [],
        )
        if _texto(
            item.get(
                "qualname"
            )
        )
    ]

    views_registradas = set(
        indice[
            "views"
        ].keys()
    )

    encontrados: dict[
        str,
        dict[str, Any],
    ] = {}

    for simbolo_directo in simbolos_directos:

        cola = deque(
            [
                (
                    simbolo_directo,
                    0,
                    [
                        simbolo_directo
                    ],
                )
            ]
        )

        visitados = {
            simbolo_directo
        }

        while cola:

            (
                actual,
                nivel,
                camino_inverso,
            ) = cola.popleft()

            if actual in views_registradas:

                perfil_view = (
                    indice[
                        "views"
                    ][
                        actual
                    ]
                )

                entrada = encontrados.setdefault(
                    actual,
                    {
                        "view":
                            actual,

                        "archivo":
                            perfil_view.get(
                                "archivo"
                            ),

                        "app":
                            perfil_view.get(
                                "app"
                            ),

                        "urls":
                            perfil_view.get(
                                "urls",
                                [],
                            ),

                        "evidencias":
                            [],
                    },
                )

                entrada[
                    "evidencias"
                ].append(
                    {
                        "simbolo_modelo":
                            simbolo_directo,

                        "distancia":
                            nivel,

                        "camino":
                            list(
                                reversed(
                                    camino_inverso
                                )
                            ),
                    }
                )

            if nivel >= profundidad:
                continue

            for llamador in indice[
                "llamadores_por_simbolo"
            ].get(
                actual,
                [],
            ):

                if llamador in visitados:
                    continue

                visitados.add(
                    llamador
                )

                cola.append(
                    (
                        llamador,
                        nivel + 1,
                        [
                            *camino_inverso,
                            llamador,
                        ],
                    )
                )

    resultados = list(
        encontrados.values()
    )

    resultados.sort(
        key=lambda item: (
            _normalizar(
                item.get(
                    "view"
                )
            )
        )
    )

    return {
        "ok":
            True,

        "modelo":
            modelo_item,

        "profundidad":
            profundidad,

        "total":
            len(
                resultados
            ),

        "resultados":
            resultados,
    }


# ============================================================
# CAMPOS Y RELACIONES DJANGO
# ============================================================

def obtener_campos_relaciones_modelo(
    modelo: str,
) -> dict[str, Any]:

    catalogo = (
        construir_catalogo_modelos()
    )

    modelo_item = (
        resolver_modelo_exacto(
            modelo,
            catalogo=catalogo,
        )
    )

    if not modelo_item:

        return {
            "ok":
                False,

            "modelo":
                modelo,

            "error":
                "Modelo no resuelto de forma exacta.",
        }

    try:

        modelo_clase = (
            apps.get_model(
                modelo_item[
                    "app_label"
                ],
                modelo_item[
                    "modelo"
                ],
            )
        )

    except LookupError:

        return {
            "ok":
                False,

            "modelo":
                modelo_item,

            "error":
                "Django no pudo resolver la clase del modelo.",
        }

    campos = []
    relaciones = []

    for campo in modelo_clase._meta.get_fields():

        relacionado = getattr(
            campo,
            "related_model",
            None,
        )

        modelo_relacionado = (
            relacionado._meta.label
            if relacionado is not None
            else None
        )

        es_relacion = bool(
            getattr(
                campo,
                "is_relation",
                False,
            )
        )

        es_concreto = bool(
            getattr(
                campo,
                "concrete",
                False,
            )
        )

        if es_concreto:

            campos.append(
                {
                    "nombre":
                        getattr(
                            campo,
                            "name",
                            "",
                        ),

                    "tipo":
                        campo.__class__.__name__,

                    "relacion":
                        es_relacion,

                    "modelo_relacionado":
                        modelo_relacionado,

                    "primary_key":
                        bool(
                            getattr(
                                campo,
                                "primary_key",
                                False,
                            )
                        ),

                    "unique":
                        bool(
                            getattr(
                                campo,
                                "unique",
                                False,
                            )
                        ),

                    "null":
                        bool(
                            getattr(
                                campo,
                                "null",
                                False,
                            )
                        ),

                    "db_column":
                        getattr(
                            campo,
                            "db_column",
                            None,
                        ),
                }
            )

        if es_relacion:

            relaciones.append(
                {
                    "nombre":
                        getattr(
                            campo,
                            "name",
                            "",
                        ),

                    "tipo":
                        campo.__class__.__name__,

                    "modelo_relacionado":
                        modelo_relacionado,

                    "many_to_many":
                        bool(
                            getattr(
                                campo,
                                "many_to_many",
                                False,
                            )
                        ),

                    "many_to_one":
                        bool(
                            getattr(
                                campo,
                                "many_to_one",
                                False,
                            )
                        ),

                    "one_to_many":
                        bool(
                            getattr(
                                campo,
                                "one_to_many",
                                False,
                            )
                        ),

                    "one_to_one":
                        bool(
                            getattr(
                                campo,
                                "one_to_one",
                                False,
                            )
                        ),

                    "auto_created":
                        bool(
                            getattr(
                                campo,
                                "auto_created",
                                False,
                            )
                        ),

                    "concrete":
                        es_concreto,
                }
            )

    campos.sort(
        key=lambda item: (
            _normalizar(
                item.get(
                    "nombre"
                )
            )
        )
    )

    relaciones.sort(
        key=lambda item: (
            _normalizar(
                item.get(
                    "nombre"
                )
            ),
            _normalizar(
                item.get(
                    "modelo_relacionado"
                )
            ),
        )
    )

    return {
        "ok":
            True,

        "modelo":
            modelo_item,

        "campos":
            campos,

        "relaciones":
            relaciones,

        "total_campos":
            len(
                campos
            ),

        "total_relaciones":
            len(
                relaciones
            ),
    }


def limpiar_cache_indice_estructural() -> None:
    """
    Utilidad interna.

    HOST022 formalizará cuándo y cómo invalidar el índice.
    """

    construir_indice_estructural.cache_clear()
